# Canonical public website origin.
PUBLIC_SITE_URL=https://www.space-tr.com

# Vercel Postgres (or another PostgreSQL connection URL) and Blob storage.
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# Shared only by the protected CMS and the public site. It signs short-lived
# draft-preview links; do not expose it to browser code.
CMS_PREVIEW_SECRET=
PREVIEW_SITE_URL=

# Optional. Leave unset while the public site reads published content through
# CMS_PREVIEW_SOURCE_URL. A Git deploy hook is only safe after production code
# and the connected Git branch are guaranteed to match.
SITE_DEPLOY_HOOK_URL=

# Optional custom editorial-draft generator override. OpenAI is used directly
# when these are empty and OPENAI_API_KEY is configured.
EDITORIAL_GENERATOR_URL=
EDITORIAL_GENERATOR_API_KEY=
CRON_SECRET=

# Observability is opt-in at build time so no paid Vercel feature is enabled by
# this repository alone.
ENABLE_VERCEL_ANALYTICS=0
ENABLE_VERCEL_SPEED_INSIGHTS=0

# Initial owner account. Use a unique 20+ character production password.
CMS_OWNER_EMAIL=
CMS_OWNER_PASSWORD=

# Independent random secrets. Generate each with: openssl rand -base64 48
CMS_SESSION_SECRET=
CMS_CSRF_SECRET=
CMS_OTP_SECRET=

# Password-recovery email delivery through Resend.
RESEND_API_KEY=
CMS_EMAIL_FROM=Space Content Studio <cms@your-verified-domain.com>

# Private bearer credential for the CMS automation API. BLOG_INGEST_API_KEY is
# still accepted as a temporary backwards-compatible fallback.
CMS_API_KEY=
BLOG_INGEST_API_KEY=

# Optional server-only profile translation. Never expose this key in CMS code.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini
OPENAI_EDITORIAL_MODEL=gpt-5-mini

# Optional Google Indexing API service-account JSON for live job changes.
GOOGLE_SERVICE_ACCOUNT_JSON=
ENABLE_SEARCH_INDEXING=0

# Existing public contact form.
CONTACT_TO=
CONTACT_FROM=

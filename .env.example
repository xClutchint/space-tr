# LinkedIn Community Management API credentials.
# Never commit a real access token.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_PERSON_ID
LINKEDIN_API_VERSION=202604
LINKEDIN_POST_COUNT=50

# Canonical public website origin used by job pages, sitemaps and indexing notifications.
PUBLIC_SITE_URL=https://www.space-tr.com

# Optional Google Indexing API service-account JSON. The service account must be
# added as an owner of the public site property in Google Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
